# Virtual Environment
myenv/
venv/
env/
.venv/

# Python Cache
__pycache__/
*.py[cod]

# Sensitive Environment Files
.env
*.env
!.env.example

# Browser Profile (Sensitive user session and auth cookies)
browser_profile/

